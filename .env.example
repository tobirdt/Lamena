# ──────────────────────────────────────────────────────────────
# Lamena — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in your Vercel project settings.
# ──────────────────────────────────────────────────────────────

# Resend API key — required for the contact form to send emails.
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# Recipient email address for contact form submissions.
# Defaults to holger@rumscheidt.de if not set.
CONTACT_TO_EMAIL=holger@rumscheidt.de

# Sender address shown in the email.
# The domain (lamena.ae) must be verified in your Resend account
# before emails can be sent. See https://resend.com/domains
CONTACT_FROM_EMAIL=Lamena Website <website@lamena.ae>
